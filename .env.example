# Optional overrides for `docker compose up` (the containerized dev
# stack: db/redis/backend/celery_worker/celery_beat/frontend).
#
# docker-compose.yml already has dev-safe defaults for all of these
# (POSTGRES_USER/PASSWORD/DB all default to "avtr") -- you only need this
# file if you want to change them. Copy to `.env` at the repo root if so;
# docker compose reads a root-level `.env` automatically for variable
# substitution (the ${VAR:-default} references in docker-compose.yml).
#
# This is separate from backend/.env, which configures the Django app
# for *non-Docker* local dev (e.g. connecting to a remote Neon Postgres
# instead of the containerized one) -- see backend/.env.example.

POSTGRES_DB=avtr
POSTGRES_USER=avtr
POSTGRES_PASSWORD=avtr

# Not actually used by docker-compose.yml today (the db host inside the
# Docker network is always the service name "db", and the port mapping
# is fixed at 5432:5432) -- listed here only as the container-network
# values to use if you're running Django directly on Windows against the
# same Docker Postgres/Redis instead of through the `backend` service.
# In that case use `localhost`, not these container-network hostnames.
POSTGRES_HOST=db
POSTGRES_PORT=5432
