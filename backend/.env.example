# Copy this file to .env and fill in real values for local (non-Docker) dev.
# Running via `docker compose up` does NOT need this file — docker-compose.yml
# supplies its own dev-safe values for the containerized Postgres/Redis stack.

# Django
SECRET_KEY=change-me-to-a-random-secret-for-local-dev
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (Neon Postgres, or any Postgres instance).
# DATABASE_URL should be a *restricted* role (no BYPASSRLS/superuser) --
# this is what the app connects as for everything except schema changes,
# so PostgreSQL row-level security (core/migrations/0003_row_level_security.py)
# actually applies to our own traffic instead of being silently bypassed.
# MIGRATE_DATABASE_URL is the more privileged owner role, used only when
# running migrate/makemigrations/etc. Falls back to DATABASE_URL if unset.
# If you're on Neon: use the *direct* (non "-pooler") host for both --
# PgBouncer-style pooling doesn't reliably preserve the session variables
# RLS depends on across requests.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
MIGRATE_DATABASE_URL=postgresql://OWNER_USER:OWNER_PASSWORD@HOST:5432/DBNAME

# Optional: run `manage.py test` against a local Postgres container
# instead of the real database above -- `docker compose up -d db_test`
# starts it (docker-compose.yml), pre-seeded with a non-superuser
# `avtr_test` role so row-level-security tests stay meaningful (a
# superuser connection silently bypasses RLS regardless of policy).
# Keeps a large/frequently-run test suite off a remote database's
# usage limits. Leave unset to test against DATABASE_URL/
# MIGRATE_DATABASE_URL like before.
TEST_DATABASE_URL=postgresql://avtr_test:avtr_test@localhost:5433/avtr_test

# Frontend origin(s) allowed to call this API. Include both localhost and
# 127.0.0.1 -- browsers treat them as different origins for CORS even
# though they're the same machine. No trailing slash on any entry --
# corsheaders' system check (E014) rejects origins with a path and
# Django refuses to start at all until it's fixed.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Used to build password-reset links (no trailing slash)
FRONTEND_URL=http://localhost:3000

# Email (password reset). Defaults to the console backend (prints to the
# server log) if unset -- fine for local dev, not for anything real.
#
# To send real emails via Resend: set EMAIL_BACKEND to the smtp backend
# below, and EMAIL_HOST_PASSWORD to your Resend API key (from
# https://resend.com/api-keys). EMAIL_HOST/EMAIL_HOST_USER already default
# to Resend's relay (smtp.resend.com / "resend") in settings.py, so they
# don't need to be set here unless you're using a different provider.
# DEFAULT_FROM_EMAIL must be onboarding@resend.dev until you verify your
# own sending domain at https://resend.com/domains (verified domains can
# send to anyone; onboarding@resend.dev can only send to your own Resend
# account email).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@avtr.local

# Celery / Redis. CELERY_BROKER_URL and CELERY_RESULT_BACKEND both default
# to REDIS_URL if unset -- only set them separately if you actually want
# the broker and result backend to be different Redis instances.
#
# `localhost` here is correct for Django/Celery running natively on
# Windows (manage.py runserver / celery -A config worker directly, no
# Docker) -- including against `docker compose up redis` specifically,
# since that service publishes 6379 to the host. Only *containers* need
# the Docker network hostname `redis://redis:6379/0` (already set for
# you in docker-compose.yml's backend/celery_worker/celery_beat
# services) -- never use `redis://redis:...` outside a container.
REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Third-party API keys (optional locally; leave blank if not testing these)
OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_SEARCH_GROUNDING_ENABLED=false
# 0.0-1.0 -- a detected mention scoring below this (core.matching.
# compute_match_confidence) is stored with needs_review=True instead of
# being presented as a confirmed detection.
MENTION_CONFIDENCE_REVIEW_THRESHOLD=0.5
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
SENTRY_DSN=
