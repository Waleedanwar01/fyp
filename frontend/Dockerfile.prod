# Production image: builds a real `next build` and serves the standalone
# server output, not the dev server. Separate from Dockerfile (dev-only,
# runs `npm run dev` against a bind-mounted source tree).
FROM node:22-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

FROM node:22-alpine AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
# NEXT_PUBLIC_* vars are inlined into the client bundle at build time,
# not read at container-start time -- must be passed as a build arg,
# not just a runtime `environment:` entry in docker-compose.
ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_SITE_URL
ENV NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL
# Small VPSes (e.g. Oracle free tier) run out of memory during the
# type-check step of `next build` and swap for hours. Types are checked in
# CI (.github/workflows/frontend-ci.yml) on every push instead, so the
# server build skips it and caps Node's heap. Override per host if needed.
ARG NEXT_SKIP_TYPECHECK=1
ENV NEXT_SKIP_TYPECHECK=$NEXT_SKIP_TYPECHECK
ARG NODE_BUILD_MEMORY_MB=2048
ENV NODE_OPTIONS=--max-old-space-size=$NODE_BUILD_MEMORY_MB
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build

# `output: "standalone"` copies only the files the server actually needs,
# so the runtime image doesn't ship the whole node_modules tree.
FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    HOSTNAME=0.0.0.0 \
    PORT=3000
COPY --from=builder /app/public ./public
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static

EXPOSE 3000
CMD ["node", "server.js"]
