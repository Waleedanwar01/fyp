# Production env for the VPS. Copy to `.env.prod` on the server and fill
# in real values -- never commit the real file (already gitignored).
#
# Used two ways:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
# `--env-file` makes docker compose substitute ${VARS} in
# docker-compose.prod.yml (e.g. NEXT_PUBLIC_API_URL below) from this file;
# `env_file:` inside that same compose file also loads it directly into
# the backend/celery containers as real environment variables.

# Django
SECRET_KEY=generate-a-real-random-secret-do-not-reuse-the-dev-one
DEBUG=False
# Your VPS's public IP (or domain, once you have one). No scheme, no port.
ALLOWED_HOSTS=YOUR_VPS_IP

# Database: Neon. Copy both connection strings from the Neon console.
# DATABASE_URL is the restricted app role (row-level security applies);
# MIGRATE_DATABASE_URL is the owner role that runs migrations.
DATABASE_URL=postgresql://avtr_app:PASSWORD@YOUR-NEON-HOST/neondb?sslmode=require
MIGRATE_DATABASE_URL=postgresql://neondb_owner:PASSWORD@YOUR-NEON-HOST/neondb?sslmode=require

# Only if you switch to the self-hosted database
# (docker-compose.selfhosted-db.yml). Letters and digits only.
# POSTGRES_PASSWORD=
# AVTR_OWNER_PASSWORD=
# AVTR_APP_PASSWORD=

# Scheduler tick: how often Beat checks for due schedules (minutes). Every
# check wakes Neon, which then bills ~5 minutes of compute -- so with Neon
# keep this high (60 = at most one wake-up an hour). 1 is fine with the
# self-hosted database. Keep the DB keep-alive off.
SCHEDULE_TICK_MINUTES=60
DB_KEEPALIVE_ENABLED=False

# Must match how the browser actually reaches you -- http://YOUR_VPS_IP
# for now (no domain/SSL yet); switch to https://yourdomain.com once you
# have both, and rebuild (see note on NEXT_PUBLIC_API_URL below).
CORS_ALLOWED_ORIGINS=http://YOUR_VPS_IP
FRONTEND_URL=http://YOUR_VPS_IP

# Email (password reset / invites). Real provider required in prod --
# the console backend just logs to nowhere anyone can see.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST_PASSWORD=your-resend-api-key
DEFAULT_FROM_EMAIL=no-reply@yourdomain.com

# Third-party API keys (Month 2+)
OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_SEARCH_GROUNDING_ENABLED=false
MENTION_CONFIDENCE_REVIEW_THRESHOLD=0.5
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
SENTRY_DSN=

# Frontend build arg (see docker-compose.prod.yml) -- baked into the
# browser bundle at `docker compose build` time, NOT read at container
# start. Must be reachable from the *browser*, not just from inside the
# Docker network -- once you're on Cloudflare Tunnel + a real domain,
# this becomes https://app.yourdomain.com/api/v1 (through the tunnel),
# not the VPS's bare IP. Changing this always requires a rebuild:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build frontend
NEXT_PUBLIC_API_URL=http://YOUR_VPS_IP/api/v1

# Cloudflare Tunnel (optional, see docker-compose.cloudflare.yml and
# docs/DEPLOYMENT.md). Leave blank if not using it yet.
CLOUDFLARE_TUNNEL_TOKEN=

# --- HTTPS hardening (see backend/config/settings.py) ---
# Turn on once the site is served over HTTPS end-to-end.
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
# Leave False behind Cloudflare Tunnel (TLS ends at Cloudflare).
SECURE_SSL_REDIRECT=False
TRUST_X_FORWARDED_PROTO=False
# e.g. https://app.example.com -- needed for Django admin logins over HTTPS.
CSRF_TRUSTED_ORIGINS=
# Public site URL for the frontend's share/SEO metadata.
NEXT_PUBLIC_SITE_URL=
